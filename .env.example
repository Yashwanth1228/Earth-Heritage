# ==============================================================================
# Earth Heritage — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development.
# Do NOT commit real credentials or .env.local to version control.
# ==============================================================================

# Supabase Public Configuration (Browser & Server)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase Server-Only Configuration (API Routes & Server Actions)
# WARNING: NEVER prefix the secret key with NEXT_PUBLIC_
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Resend Server-Only Email Notification Configuration
# WARNING: NEVER prefix RESEND_API_KEY with NEXT_PUBLIC_
RESEND_API_KEY=your_resend_api_key
ENQUIRY_NOTIFICATION_EMAIL=support@earthheritage.in
# Optional: customize sender once earthheritage.in is verified in Resend (default: Earth Heritage <onboarding@resend.dev>)
RESEND_FROM_EMAIL=Earth Heritage <onboarding@resend.dev>

# Cloudinary Media Management Configuration
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

